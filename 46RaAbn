function renderMatches(list){

const container=document.getElementById("matchContainer");

container.innerHTML=list.map(m=>`

<div class="match">

<div class="competition">${m.comp}</div>

<div class="date">${m.date}</div>

<div class="teams">
<span>${m.home}</span>
<span class="score">${m.score}</span>
<span>${m.away}</span>
</div>

${m.status==="upcoming"
?'<small style="color:#edbb00">⏳ À venir</small>'
:'<small style="color:#55dd88">✓ Terminé</small>'}

</div>

`).join("");

}


function filterMatches(type){

let result=matches;

if(type==="liga")
result=matches.filter(m=>m.comp==="La Liga");

if(type==="ucl")
result=matches.filter(m=>m.comp==="Champions League");

if(type==="upcoming")
result=matches.filter(m=>m.status==="upcoming");

renderMatches(result);

}


function showHistory(type){

let result=matches;

if(type==="played")
result=matches.filter(m=>m.status==="played");

if(type==="liga")
result=matches.filter(m=>m.comp==="La Liga");

if(type==="ucl")
result=matches.filter(m=>m.comp==="Champions League");

if(type==="super")
result=matches.filter(m=>m.comp==="Supercopa");

document.getElementById("historyContainer").innerHTML=result.map(m=>`

<div class="history-match ${m.status==="upcoming"?'upcoming':''}">

<div class="history-date">${m.date}</div>

<div class="history-teams">
${m.home} — ${m.away}
</div>

<div class="history-score">
${m.score}
</div>

<div class="history-comp">
${m.comp}
</div>

</div>

`).join("");

}


