<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BARÇA MATCH CENTER</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

html{scroll-behavior:smooth}

body{
    font-family:Arial,Helvetica,sans-serif;
    color:white;
    background:
      linear-gradient(rgba(5,8,25,.88),rgba(5,8,25,.94)),
      url("https://images.unsplash.com/photo-1579952363873-27f3bade9f55?auto=format&fit=crop&w=2000&q=80")
      center/cover fixed;
}

header{
    position:sticky;
    top:0;
    z-index:1000;
    background:rgba(7,7,25,.96);
    border-bottom:2px solid #a50044;
    padding:12px 20px;
}

.header-content{
    max-width:1200px;
    margin:auto;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
}

.logo{
    display:flex;
    align-items:center;
    gap:12px;
}

.logo img{
    width:55px;
    height:55px;
    object-fit:contain;
}

.logo h1{
    font-size:22px;
}

.logo span{
    color:#edbb00;
}

nav{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    gap:8px;
}

nav a{
    color:white;
    text-decoration:none;
    padding:9px 12px;
    border-radius:20px;
    background:#17172d;
    font-size:13px;
}

nav a:hover{
    background:#a50044;
}

.hero{
    min-height:360px;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:40px 20px;
}

.hero h2{
    font-size:60px;
    text-shadow:0 4px 20px black;
}

.hero p{
    margin-top:15px;
    font-size:20px;
    color:#ddd;
}

.container{
    width:min(1200px,94%);
    margin:auto;
}

section{
    margin:45px 0;
    scroll-margin-top:100px;
}

.section-title{
    font-size:30px;
    margin-bottom:20px;
    border-left:5px solid #edbb00;
    padding-left:12px;
}

.cards{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
}

.card{
    background:rgba(18,18,42,.9);
    border:1px solid rgba(255,255,255,.12);
    border-radius:18px;
    padding:22px;
    text-align:center;
    box-shadow:0 8px 30px rgba(0,0,0,.3);
}

.card .big{
    font-size:35px;
    font-weight:bold;
    color:#edbb00;
}

.card p{
    color:#bbb;
    margin-top:7px;
}

.match-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.match{
    background:linear-gradient(145deg,#10102b,#171744);
    border-radius:18px;
    padding:20px;
    border-top:4px solid #a50044;
    text-align:center;
}

.match .competition{
    color:#edbb00;
    font-size:13px;
    margin-bottom:12px;
}

.match .date{
    color:#aaa;
    font-size:13px;
}

.teams{
    display:flex;
    justify-content:space-around;
    align-items:center;
    gap:10px;
    margin:18px 0;
    font-weight:bold;
}

.score{
    font-size:28px;
    color:#edbb00;
}

.filters{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    margin-bottom:20px;
}

button,select,input{
    border:0;
    border-radius:10px;
    padding:11px 14px;
    font-size:14px;
}

button{
    cursor:pointer;
    background:#a50044;
    color:white;
}

button:hover{
    background:#edbb00;
    color:#111;
}

input,select{
    background:white;
    color:#111;
}

table{
    width:100%;
    border-collapse:collapse;
    overflow:hidden;
    border-radius:15px;
    background:rgba(15,15,40,.95);
}

th,td{
    padding:12px 9px;
    text-align:center;
    border-bottom:1px solid rgba(255,255,255,.1);
}

th{
    background:#a50044;
}

tr:hover{
    background:rgba(255,255,255,.05);
}

.first{
    background:rgba(237,187,0,.15);
    font-weight:bold;
}

.player-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
}

.player{
    background:rgba(17,17,42,.95);
    border-radius:18px;
    overflow:hidden;
    text-align:center;
    border:1px solid rgba(255,255,255,.1);
}

.player img{
    width:100%;
    height:220px;
    object-fit:cover;
    background:#111;
}

.player-info{
    padding:14px;
}

.player-number{
    color:#edbb00;
    font-size:14px;
}

.player-name{
    font-size:18px;
    font-weight:bold;
    margin-top:5px;
}

.history-box{
    background:rgba(12,12,35,.94);
    border-radius:20px;
    padding:20px;
}

.history-match{
    display:grid;
    grid-template-columns:130px 1fr 100px 150px;
    align-items:center;
    gap:15px;
    padding:15px;
    margin-bottom:10px;
    border-radius:12px;
    background:#171733;
    border-left:4px solid #a50044;
}

.history-date{
    color:#edbb00;
    font-weight:bold;
}

.history-teams{
    font-weight:bold;
}

.history-score{
    font-size:21px;
    text-align:center;
}

.history-comp{
    color:#aaa;
    text-align:right;
    font-size:13px;
}

.upcoming{
    border-left-color:#edbb00;
}

.edit-box{
    background:rgba(15,15,40,.96);
    padding:25px;
    border-radius:20px;
}

.form-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:15px;
}

.form-group{
    display:flex;
    flex-direction:column;
    gap:7px;
}

.form-group label{
    color:#ccc;
}

footer{
    margin-top:60px;
    padding:30px;
    text-align:center;
    background:#070719;
    color:#aaa;
}

@media(max-width:900px){
    .cards{grid-template-columns:repeat(2,1fr)}
    .match-grid{grid-template-columns:repeat(2,1fr)}
    .player-grid{grid-template-columns:repeat(3,1fr)}
    .history-match{
        grid-template-columns:1fr;
        text-align:center;
    }
    .history-comp{text-align:center}
}

@media(max-width:600px){
    header{
        position:relative;
    }

    .header-content{
        flex-direction:column;
    }

    .hero h2{
        font-size:40px;
    }

    .cards,
    .match-grid,
    .player-grid{
        grid-template-columns:1fr;
    }

    .form-grid{
        grid-template-columns:1fr;
    }

    nav a{
        font-size:11px;
        padding:8px 9px;
    }

    table{
        font-size:12px;
    }

    th,td{
        padding:8px 4px;
    }
}
</style>
</head>

